# What the source collection for Flatcar Container Linux 4081.3.12 (lts,
# amd64) trusts, reviewed 2026-11-13. The run refuses anything else.

# flatcar/scripts tag lts-4081.3.12 points at this commit. The tag is signed
# by a maintainer, not by Flatcar's image key, so the commit is pinned.
TAG_COMMIT=4fb4cb0559bbf2b196feaffad68a22f3ee095aa7

# The SDK the tag pins (FLATCAR_SDK_VERSION=4081.0.0 in
# sdk_container/.repo/manifests/version.txt), by digest, so a moved tag on
# the registry cannot change what checks the downloads.
SDK_IMAGE=ghcr.io/flatcar/flatcar-sdk-amd64@sha256:deb4577c483df764d76c7e27e7a662d41167935319b388e997c7a4e0629b26c9

# On the appliance's disks but in no package list Flatcar publishes: the
# boot loaders on the EFI system partition, the kernel's source package
# (the version of coreos-kernel in the image list) and the Hyper-V OEM
# package. Each is the only ebuild of its package at the tag.
EXTRA_ATOMS="=sys-boot/grub-2.06-r10 =sys-boot/shim-15.8-r1 =sys-kernel/coreos-sources-6.6.160 =coreos-base/oem-hyperv-0.1.0-r1"
